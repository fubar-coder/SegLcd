<!--
  USB passthrough of the Thermaltake LB360-S segment LCD (5131:200e) into a libvirt VM.
  Also works under qemu:///session if the user has write access to
  /dev/bus/usb/BBB/DDD (udev rule udev/70-seglcd.rules).

  Attach / detach live:
    virsh -c qemu:///session attach-device Win11Pro vm/lb360s-usb-hostdev.xml --live
    virsh -c qemu:///session detach-device Win11Pro vm/lb360s-usb-hostdev.xml --live
  Permanently (on every VM start; startupPolicy=optional -> the VM also starts without the device):
    virsh -c qemu:///session attach-device Win11Pro vm/lb360s-usb-hostdev.xml --config
-->
<hostdev mode='subsystem' type='usb'>
  <source startupPolicy='optional'>
    <vendor id='0x5131'/>
    <product id='0x200e'/>
  </source>
</hostdev>
