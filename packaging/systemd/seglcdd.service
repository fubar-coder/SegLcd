# User service for the segment LCD of the Thermaltake LB360-S ARGB Sync.
# Installation: packaging/install-user.sh   (or manually, see the documentation, "seglcdd service")
[Unit]
Description=SegLcd – sensor values on the Thermaltake LB360-S pump display
Documentation=file://%h/.local/share/doc/seglcd/README.md

[Service]
Type=notify
ExecStart=%h/.local/bin/seglcdd
ExecReload=/usr/bin/busctl --user call io.github.fubar_coder.SegLcd1 /io/github/fubar_coder/SegLcd1 io.github.fubar_coder.SegLcd1 ReloadConfig
Restart=on-failure
RestartSec=3
# Hardening (user service: only what works without privileges)
NoNewPrivileges=yes
PrivateTmp=yes
LockPersonality=yes
RestrictRealtime=yes

[Install]
WantedBy=default.target
