# OPTIONAL: make the RAPL energy counters (CPU package power) readable for the group "rapl".
#
# Since Linux 5.10 energy_uj is readable by root only (PLATYPUS, CVE-2020-8694/8695:
# fine-grained energy values allow conclusions about running computations).
# This rule opens the counter ONLY for members of the group "rapl" – much narrower than
# e.g. btop, which gets cap_dac_read_search (read access to ALL files) for this.
#
# Installation:
#   sudo install -m 644 udev/rapl.sysusers.conf /etc/sysusers.d/rapl.conf
#   sudo systemd-sysusers
#   sudo usermod -aG rapl "$USER"            # log in again afterwards
#   sudo install -m 644 udev/72-rapl-energy-read.rules /etc/udev/rules.d/
#   sudo udevadm control --reload
#   sudo udevadm trigger --action=add --subsystem-match=powercap
SUBSYSTEM=="powercap", KERNEL=="intel-rapl:*", ACTION=="add|change", RUN+="/usr/bin/chgrp rapl /sys%p/energy_uj", RUN+="/usr/bin/chmod 0440 /sys%p/energy_uj"
