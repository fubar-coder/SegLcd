<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <RootNamespace>SegLcd.Client</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Tmds.DBus.Generator" Version="0.95.2" PrivateAssets="all" />
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.95.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SegLcd.Localization\SegLcd.Localization.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Same interface definition as the service; Tmds.DBus.Generator creates the client proxy from it. -->
    <AdditionalFiles Include="..\SegLcd.Daemon\DBus\io.github.fubar_coder.SegLcd1.xml"
                     DBusGeneratorMode="Proxy"
                     Namespace="SegLcd.Client.DBus" />
  </ItemGroup>

</Project>
